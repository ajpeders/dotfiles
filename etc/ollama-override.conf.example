[Service]
# Safe local-only default. Change to 0.0.0.0:11434 only after configuring
# and enabling ollama-gate.nft for your own trusted networks.
Environment="OLLAMA_HOST=127.0.0.1:11434"
# Optional, machine-specific tuning:
# Environment="OLLAMA_MODELS=/path/to/models"
# Environment="OLLAMA_CONTEXT_LENGTH=98304"
# Environment="OLLAMA_NUM_PARALLEL=1"
