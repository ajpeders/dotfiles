# Ignore everything by default
*
*/

# Keep configuration directories
!.gitignore
!CLAUDE.md
!README.md
!ARCHITECTURE.md
!ROADMAP.md
!HOWTO.md
!update.sh
!install.sh
!sync-private.sh
!omarchy-shell.sh
!packages.txt
!.hermes/
!hypr/
!theme/
!kitty/
!wallpapers/
!gtk-3.0/
!gtk-4.0/
!zsh/
!noctalia/
!noctalia/**
!yazi/
!macos/
!git/
!tmux/
!nvim/
!systemd/
!systemd/user/
!systemd/user/noctalia-shell.service
!librewolf/
!librewolf/policies.json

# Omarchy (4.x) user-owned config. Omarchy itself lives in /usr/share/omarchy
# and is package-managed; only these user override files belong in the repo.
!omarchy/
!omarchy/shell.json
!omarchy/extensions/
!omarchy/branding/
!omarchy/themes/
!omarchy/hooks/

# Keep config files in tracked directories
!.hermes/**
!hypr/**
!theme/**
!kitty/**
!wallpapers/**
!gtk-3.0/**
!gtk-4.0/**
!zsh/**
!noctalia/**
!yazi/**
!macos/**
!git/**
!tmux/**
!nvim/**
!omarchy/extensions/**
!omarchy/branding/**
!omarchy/themes/**
!omarchy/hooks/**

# Ignore generated hypridle symlink (written by scripts/hypridle-power.sh;
# points at hypridle-ac.conf or hypridle-battery.conf depending on power source)
hypr/hypridle.conf

# Ignore generated zsh runtime files
zsh/.zcompdump*
zsh/.zsh_history
zsh/.zsh_sessions/

# Ignore editor/backup files anywhere in the tree
**/*.bak

# Omarchy ships these as stock samples / installs them on update; they are not
# user configuration and would churn on every `omarchy update`.
omarchy/hooks/**/*.sample
omarchy/hooks/**/*.hook

# Editor/template backups left by the Omarchy config port.
**/*.omarchy-template.bak
