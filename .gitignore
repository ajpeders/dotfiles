# ~/.config *is* the repo, so ignore everything and allow-list what belongs.
*
*/

# Repo metadata + docs
!.gitignore
!README.md
!ARCHITECTURE.md
!ROADMAP.md
!HOWTO.md
!etc/
!etc/**

# Bootstrap + maintenance entry points
!scripts/
!scripts/**
!packages.txt
!packages-asahi.txt

# Shared config dirs (whole tree tracked)
!hypr/
!hypr/**
!kitty/
!kitty/**
!fontconfig/
!fontconfig/**
!gtk-3.0/
!gtk-3.0/**
!gtk-4.0/
!gtk-4.0/**
!zsh/
!zsh/**
# jetshell/ lives at ~/code/jetshell now; ~/.config/jetshell is a symlink to
# that repo and the dotfiles repo does not track the shell's source.
!yazi/
!yazi/**
!macos/
!macos/**
!git/
!git/**
!tmux/
!tmux/**
!nvim/
!nvim/**
# Keychron Q1 HE keymap export (restore via VIA/Launcher)
!keychron/
!keychron/**

# opencode: config tracked, but it writes runtime cruft into the same dir
!opencode/
!opencode/**
opencode/node_modules/
opencode/package.json
opencode/package-lock.json
opencode/bun.lock
opencode/.gitignore
opencode/.opencode/
opencode/service.json

# Vaultwarden CLI: server/email config + keyring-backed pinentry shim (no secrets)
!rbw/
!rbw/config.json
!rbw/pinentry-rbw

# Single files inside otherwise-ignored dirs
!librewolf/
!librewolf/policies.json

# The shell's systemd user unit. Everything else in systemd/ is per-machine.
!systemd/
!systemd/user/
!systemd/user/jetshell.service

# Session env defaults (LLM_SERVER_URL for opencode);
# per-machine overrides stay out, same as llm.env.
!environment.d/
!environment.d/*.conf
environment.d/90-llm-local.conf

# Generated hypridle symlink (written by hypr/scripts/hypridle-power.sh;
# points at hypridle-ac.conf or hypridle-battery.conf depending on power source)
hypr/hypridle.conf

# Rendered by Quickshell at runtime. kitty is rendered today; the GTK palettes
# are frozen copies (see ROADMAP) until Quickshell renders them too.
kitty/themes/quickshell.conf
gtk-3.0/quickshell.css
gtk-4.0/quickshell.css

# Zsh runtime files
zsh/.zcompdump*
zsh/.zsh_history
zsh/.zsh_sessions/

# Editor / installer backups anywhere in the tree. The -* variant catches
# timestamped backups (aerospace.toml.bak-20260901-004455), which *.bak
# does not; install.sh writes <file>.pre-dotfiles before symlinking.
**/*.bak
**/*.bak-*
**/*.pre-dotfiles

# Python bytecode caches
**/__pycache__/
**/*.pyc
