# Ignore everything by default
*
*/

# Keep configuration directories
!.gitignore
!CLAUDE.md
!README.md
!ARCHITECTURE.md
!ROADMAP.md
!HOWTO.md
# Bootstrap + maintenance entry points (moved here from the repo root)
!scripts/
!scripts/**
!packages.txt
!packages-asahi.txt
!hypr/
!theme/
!kitty/
!wallpapers/
# Per-host $HOME dotfiles (see hosts/<name>/README.md)
!hosts/
!hosts/**
!gtk-3.0/
!gtk-4.0/
!zsh/
!noctalia/
!noctalia/**
!yazi/
!opencode/
!opencode/**
# ...but opencode writes its own runtime cruft into its config dir,
# and that dir is a symlink to this repo. Keep it out of the tree.
opencode/node_modules/
opencode/package.json
opencode/package-lock.json
opencode/bun.lock
opencode/.gitignore
!macos/
!git/
!tmux/
!nvim/
!systemd/
!systemd/user/
!systemd/user/noctalia-shell.service
!librewolf/
!librewolf/policies.json

# Omarchy (4.x) user-owned config. Omarchy itself lives in /usr/share/omarchy
# and is package-managed; only these user override files belong in the repo.
!omarchy/
!omarchy/shell.json
!omarchy/extensions/
!omarchy/branding/
!omarchy/themes/
!omarchy/hooks/

# Keep config files in tracked directories
!hypr/**
!theme/**
!kitty/**
!wallpapers/**
!gtk-3.0/**
!gtk-4.0/**
!zsh/**
!noctalia/**
!yazi/**
!macos/**
!git/**
!tmux/**
!nvim/**
!omarchy/extensions/**
!omarchy/branding/**
!omarchy/themes/**
!omarchy/hooks/**

# Ignore generated hypridle symlink (written by scripts/hypridle-power.sh;
# points at hypridle-ac.conf or hypridle-battery.conf depending on power source)
hypr/hypridle.conf

# Ignore generated zsh runtime files
zsh/.zcompdump*
zsh/.zsh_history
zsh/.zsh_sessions/

# Ignore editor/backup files anywhere in the tree.
# The -* variant catches timestamped backups (aerospace.toml.bak-20260901-004455),
# which plain *.bak does not match.
**/*.bak
**/*.bak-*
# Ignore installer backups (install.sh writes <file>.pre-dotfiles before symlinking)
**/*.pre-dotfiles

# Omarchy ships these as stock samples / installs them on update; they are not
# user configuration and would churn on every `omarchy update`.
omarchy/hooks/**/*.sample
omarchy/hooks/**/*.hook

# Editor/template backups left by the Omarchy config port.
**/*.omarchy-template.bak

# Rendered by Noctalia v5 theme templates on every palette change
hypr/noctalia.lua
kitty/themes/noctalia.conf
