<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/propertylist-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alex.dotfiles-autopull</string>

    <!-- Same $HOME trick as com.alex.mount.share: launchd does not expand ~. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "$HOME/dotfiles/scripts/autopull.sh"</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Every 15 minutes; the script is a no-op fetch when nothing changed. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardErrorPath</key>
    <string>/tmp/com.alex.dotfiles-autopull.err</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.alex.dotfiles-autopull.out</string>
</dict>
</plist>
