<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/propertylist-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alex.tailscale</string>
    <!-- Launch the menu-bar app at login; it reconnects the tunnel on its own.
         The App Store build self-starts, but the standalone cask
         (io.tailscale.ipn.macsys) leaves TailscaleStartOnLogin off, so drive it
         from launchd instead of the GUI toggle. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-g</string>
        <string>/Applications/Tailscale.app</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/com.alex.tailscale.err</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.alex.tailscale.out</string>
</dict>
</plist>
