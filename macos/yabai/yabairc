#!/usr/bin/env sh
# yabai — BSP tiling WM for macOS, ported from the AeroSpace config next door.
#
# The AeroSpace config is kept in macos/aerospace/ so you can switch back. The
# two must never run at once: they both drive the Accessibility API and will
# fight over every window.
#
# Requires SIP partially disabled (fs, debug, nvram) and the scripting
# addition loaded — see scripts/setup-yabai.sh.

# ---------- Scripting addition ----------
# Dock restarts on login, display changes and macOS updates; reload after each.
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# ---------- Layout ----------
yabai -m config layout                      bsp
yabai -m config window_placement            second_child
yabai -m config split_ratio                 0.50
yabai -m config auto_balance                off

# ---------- Gaps ----------
# 8 on every edge, matching the [gaps] block in aerospace.toml.
yabai -m config top_padding                 8
yabai -m config bottom_padding              8
yabai -m config left_padding                8
yabai -m config right_padding               8
yabai -m config window_gap                  8

# ---------- Focus / mouse ----------
# mouse_follows_focus warps the cursor on every focus change — that is the
# per-window warping that caused focus ping-pong under AeroSpace, so it stays
# off. focus_follows_mouse is the opposite direction and does not have that
# problem; 'autofocus' focuses without raising, which is the Hyprland feel.
# Set to 'off' if you would rather click to focus.
yabai -m config focus_follows_mouse         autofocus
yabai -m config mouse_follows_focus         off

yabai -m config mouse_modifier              fn
yabai -m config mouse_action1               move
yabai -m config mouse_action2               resize
yabai -m config mouse_drop_action           swap

# ---------- Rules ----------
# Ported from the [[on-window-detected]] blocks in aerospace.toml.
yabai -m rule --add app="^System Settings$"  manage=on
yabai -m rule --add app="^LibreWolf$"        manage=on
# Tailscale ships LSUIElement=1 but promotes itself to a regular app at runtime.
yabai -m rule --add app="^Tailscale$"        manage=on

# Dialog-shaped things that should never be tiled.
yabai -m rule --add app="^(Calculator|System Information|Activity Monitor|Archive Utility)$" manage=off
yabai -m rule --add app="^Finder$" title="^(Copy|Connect to Server|Move|Info|Delete)" manage=off

echo "yabai config loaded"
