[Unit]
Description=Noctalia desktop shell (Quickshell)
Documentation=https://github.com/noctalia-dev/noctalia-shell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c noctalia-shell
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
