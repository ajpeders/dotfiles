#!/bin/bash
# Copy the Omarchy-rendered yazi theme into ~/.config/yazi/theme.toml.
# Called from `omarchy-hook theme-set` after a theme change.

set -euo pipefail

source="$HOME/.local/state/omarchy/current/theme/yazi-theme.toml"
dest_dir="$HOME/.config/yazi"
dest="$dest_dir/theme.toml"

if [ ! -r "$source" ]; then
    # No rendered theme yet (first theme-set without the template, or template
    # missing). Bail silently — the user's manual theme.toml stays in place.
    exit 0
fi

mkdir -p "$dest_dir"
cp -f "$source" "$dest"
