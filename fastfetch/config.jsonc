{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Small Arch logo, sized for a ~65-column tile. Colors are raw SGR codes
    // (3x = ANSI colour x) so they follow the light/dark kitty palette.
    "logo": {
        "type": "builtin",
        "source": "arch_small",
        "color": { "1": "31", "2": "91" },
        "padding": { "top": 2, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "36", "title": "1;31", "separator": "90" },
        "bar": { "char": { "elapsed": "■", "total": "·" }, "border": { "left": "", "right": "" }, "width": 12 },
        "percent": { "type": ["num", "bar"] }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "separator", "string": "─" },
        { "type": "os", "key": "os    ", "format": "{name} {arch}" },
        { "type": "kernel", "key": "kernel", "format": "{release}" },
        { "type": "uptime", "key": "uptime" },
        { "type": "packages", "key": "pkgs  " },
        { "type": "shell", "key": "shell ", "format": "{pretty-name}" },
        { "type": "wm", "key": "wm    ", "format": "{pretty-name}" },
        { "type": "terminal", "key": "term  ", "format": "{pretty-name}" },
        "break",
        { "type": "cpu", "key": "cpu   ", "format": "{name}" },
        { "type": "gpu", "key": "gpu   ", "format": "{name}", "hideType": "integrated" },
        { "type": "memory", "key": "memory", "format": "{percentage-bar} {used} / {total}" },
        { "type": "disk", "key": "disk  ", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total}" },
        "break",
        { "type": "colors", "symbol": "block" }
    ]
}
