#!/usr/bin/env bash
# prepare-commit-msg hook (global)
# Strip co-author and Claude-attribution trailers from commit messages.
# Patterns stripped (case-insensitive, line-start):
#   Co-Authored-By: <anyone>
#   Claude-Session: ...
#   Claude-Model: ...
#   Claude: ...
#
# Wired up by core.hooksPath in ~/.config/git/config.
#
# Args (from git): $1=msg-file  $2=source  $3=sha1
COMMIT_MSG_FILE="$1"
SOURCE="$2"

# Leave merge messages alone.
case "$SOURCE" in
  merge)            exit 0 ;;
esac

# -E: extended regex. -i: case-insensitive (GNU grep; on BSD use -i too, works either way).
grep -v -i -E \
  '^[ \t]*(Co-Authored-By:|Claude(-Session|-Model)?:)' \
  "$COMMIT_MSG_FILE" > "$COMMIT_MSG_FILE.tmp"
# grep exits 1 when every line was stripped; the (empty) result still stands.
mv "$COMMIT_MSG_FILE.tmp" "$COMMIT_MSG_FILE"

exit 0
