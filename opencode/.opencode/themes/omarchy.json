{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#1e100c",
    "bgDark": "#180b08",
    "bgLight": "#2b1c18",
    "fg": "#f9dcd6",
    "fgDark": "#a48b86",
    "fgLight": "#dcc1ba",
    "fgBright": "#ffdad2",
    "muted": "#55423e",
    "selection": "#643d25",
    "accent": "#dc441f",
    "red": "#ffb3b3",
    "yellow": "#ffb951",
    "orange": "#ffb597",
    "green": "#8adc00",
    "cyan": "#00e1ad",
    "blue": "#b8c4ff",
    "magenta": "#efb0ff",
    "brown": "#ffb59b",
    "bRed": "#ffe6e6",
    "bYellow": "#ffce84",
    "bGreen": "#a6ff10",
    "bCyan": "#15ffc9",
    "bBlue": "#ebeeff",
    "bMagenta": "#f9e3ff"
  },
  "theme": {
    "primary": { "dark": "orange", "light": "accent" },
    "secondary": { "dark": "yellow", "light": "accent" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "fg", "light": "bg" },
    "textMuted": { "dark": "fgDark", "light": "fgDark" },
    "background": { "dark": "bg", "light": "fg" },
    "backgroundPanel": { "dark": "bgDark", "light": "fgLight" },
    "backgroundElement": { "dark": "bgLight", "light": "fg" },
    "border": { "dark": "muted", "light": "muted" },
    "borderActive": { "dark": "accent", "light": "accent" },
    "borderSubtle": { "dark": "muted", "light": "muted" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "fgDark", "light": "fgDark" },
    "diffHighlightAdded": { "dark": "bGreen", "light": "bGreen" },
    "diffHighlightRemoved": { "dark": "bRed", "light": "bRed" },
    "diffAddedBg": { "dark": "selection", "light": "selection" },
    "diffRemovedBg": { "dark": "selection", "light": "selection" },
    "diffContextBg": { "dark": "bgDark", "light": "fgLight" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "selection", "light": "selection" },
    "diffRemovedLineNumberBg": { "dark": "selection", "light": "selection" },
    "markdownText": { "dark": "fg", "light": "bg" },
    "markdownHeading": { "dark": "orange", "light": "accent" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "cyan", "light": "cyan" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "fgDark", "light": "fgDark" },
    "markdownEmph": { "dark": "yellow", "light": "yellow" },
    "markdownStrong": { "dark": "fgBright", "light": "fgBright" },
    "markdownHorizontalRule": { "dark": "muted", "light": "muted" },
    "markdownListItem": { "dark": "orange", "light": "accent" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "cyan", "light": "cyan" },
    "markdownCodeBlock": { "dark": "fg", "light": "bg" },
    "syntaxComment": { "dark": "fgDark", "light": "fgDark" },
    "syntaxKeyword": { "dark": "blue", "light": "blue" },
    "syntaxFunction": { "dark": "orange", "light": "accent" },
    "syntaxVariable": { "dark": "cyan", "light": "cyan" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "magenta", "light": "magenta" },
    "syntaxType": { "dark": "cyan", "light": "cyan" },
    "syntaxOperator": { "dark": "blue", "light": "blue" },
    "syntaxPunctuation": { "dark": "fg", "light": "bg" }
  }
}
