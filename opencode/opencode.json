{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/{env:LLM_MODEL}",
  "small_model": "ollama/qwen3:8b",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (LLM_SERVER_URL)",
      "options": {
        "baseURL": "{env:LLM_SERVER_URL}",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B",
          "limit": { "context": 32768, "output": 16384 }
        },
        "qwen3.6:27b": {
          "name": "Qwen3.6 27B",
          "limit": { "context": 32768, "output": 16384 }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B",
          "limit": { "context": 32768, "output": 16384 }
        },
        "qwen2.5:7b-instruct": {
          "name": "Qwen2.5 7B Instruct",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  }
}
