{
  "$schema": "https://opencode.ai/config.json",

  "model": "deepseek/deepseek-v4-pro",
  "small_model": "ollama/qwen3-coder:30b",

  "plugin": [
    "@whisperopencode/push"
  ],

  "disabled_providers": ["xai"],

  "agent": {
    "build": {
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:./prompts/build.txt}",
      "color": "primary",
      "temperature": 0.2,
      "steps": 50,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git push --force*": "deny",
          "rm -rf*": "ask",
          "rm -rf /*": "deny",
          "mkfs*": "deny",
          "dd if=*": "deny",
          ":(){ :|:& };:*": "deny"
        },
        "webfetch": "allow"
      }
    },
    "plan": {
      "model": "minimax-coding-plan/MiniMax-M3",
      "prompt": "{file:./prompts/plan.txt}",
      "color": "secondary",
      "temperature": 0.1,
      "permission": {
        "bash": "deny"
      }
    },
    "general": {
      "model": "ollama/qwen3-coder:30b",
      "color": "accent",
      "temperature": 0.3
    },
    "explore": {
      "model": "ollama/qwen3-coder:30b",
      "color": "info",
      "temperature": 0.3
    },
    "scout": {
      "model": "ollama/qwen3-coder:30b",
      "color": "info",
      "temperature": 0.3
    },
    "review": {
      "description": "Reviews code for security, performance, and maintainability without making changes",
      "mode": "subagent",
      "model": "ollama/qwen3-coder:30b",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability. Provide constructive feedback without making direct changes.",
      "color": "warning",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "docs-writer": {
      "description": "Writes and maintains documentation: READMEs, docstrings, changelogs, ADRs. Edits prose files only — no shell, no code logic changes.",
      "mode": "subagent",
      "model": "ollama/qwen3-coder:30b",
      "prompt": "{file:./prompts/docs-writer.txt}",
      "color": "success",
      "temperature": 0.5,
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "webfetch": "allow"
      }
    },
    "debug": {
      "description": "Investigates bugs, crashes, and runtime issues using logs, traces, and network diagnostics. Read-only — never modifies project files.",
      "mode": "subagent",
      "model": "ollama/qwen3.6:27b",
      "prompt": "{file:./prompts/debug.txt}",
      "color": "error",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "journalctl *": "allow",
          "dmesg *": "allow",
          "cat /var/log/*": "allow",
          "tail *": "allow",
          "less *": "allow",
          "head *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "ls *": "allow",
          "ps *": "allow",
          "top *": "allow",
          "htop *": "allow",
          "lsof *": "allow",
          "strace *": "allow",
          "ltrace *": "allow",
          "gdb *": "allow",
          "coredumpctl *": "allow",
          "ip *": "allow",
          "ss *": "allow",
          "netstat *": "allow",
          "ping *": "allow",
          "traceroute *": "allow",
          "curl *": "allow",
          "wget *": "allow",
          "dig *": "allow",
          "nslookup *": "allow",
          "systemctl status *": "allow",
          "systemctl show *": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "rm -rf*": "deny",
          "mkfs*": "deny",
          "dd if=*": "deny",
          ":(){ :|:& };:*": "deny"
        }
      }
    }
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (LLM_SERVER_URL)",
      "options": {
        "baseURL": "{env:LLM_SERVER_URL}",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B",
          "limit": { "context": 262144, "output": 16384 }
        },
        "qwen3.6:27b": {
          "name": "Qwen3.6 27B",
          "limit": { "context": 262144, "output": 16384 }
        },
        "qwen3:8b-32k": {
          "name": "Qwen3 8B 32K",
          "limit": { "context": 40960, "output": 16384 }
        }
      }
    }
  }
}
