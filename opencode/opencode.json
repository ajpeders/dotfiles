{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.6:35b-a3b",
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "xai",
        "effect": "deny"
      }
    ]
  },
  "agents": {
    "title": {
      "model": "ollama/qwen3.6:35b-a3b"
    },
    "build": {
      "model": "ollama/qwen3.6:35b-a3b",
      "color": "#8aadf4",
      "steps": 50,
      "system": "{file:./prompts/build.txt}",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push --force*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "rm -rf*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "rm -rf /*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "mkfs*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "dd if=*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": ":(){ :|:& };:*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "plan": {
      "model": "ollama/qwen3.6:35b-a3b",
      "color": "#c6a0f6",
      "system": "{file:./prompts/plan.txt}",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "general": {
      "model": "ollama/qwen3.6:35b-a3b",
      "color": "#f5bde6",
      "request": {
        "body": {
          "temperature": 0.3
        }
      }
    },
    "explore": {
      "model": "ollama/qwen3.6:35b-a3b",
      "color": "#7dc4e4",
      "request": {
        "body": {
          "temperature": 0.3
        }
      }
    },
    "scout": {
      "model": "ollama/qwen3.6:35b-a3b",
      "color": "#7dc4e4",
      "request": {
        "body": {
          "temperature": 0.3
        }
      }
    },
    "review": {
      "description": "Reviews code for security, performance, and maintainability without making changes",
      "mode": "subagent",
      "model": "ollama/qwen3.6:35b-a3b",
      "color": "#eed49f",
      "system": "You are a code reviewer. Focus on security, performance, and maintainability. Provide constructive feedback without making direct changes.",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "docs-writer": {
      "description": "Writes and maintains documentation: READMEs, docstrings, changelogs, ADRs. Edits prose files only — no shell, no code logic changes.",
      "mode": "subagent",
      "model": "ollama/qwen3.6:35b-a3b",
      "color": "#a6da95",
      "system": "{file:./prompts/docs-writer.txt}",
      "request": {
        "body": {
          "temperature": 0.5
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "debug": {
      "description": "Investigates bugs, crashes, and runtime issues using logs, traces, and network diagnostics. Read-only — never modifies project files.",
      "mode": "subagent",
      "model": "ollama/qwen3.6:35b-a3b",
      "color": "#ed8796",
      "system": "{file:./prompts/debug.txt}",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "journalctl *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "dmesg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cat /var/log/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "less *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ps *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "top *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "htop *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "lsof *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "strace *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ltrace *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gdb *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "coredumpctl *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ip *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ss *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "netstat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ping *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "traceroute *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "curl *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wget *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "dig *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "nslookup *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "systemctl status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "systemctl show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rm -rf*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "mkfs*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "dd if=*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": ":(){ :|:& };:*",
          "effect": "deny"
        }
      ]
    }
  },
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    },
    "ollama": {
      "name": "llama-swap (LLM_SERVER_URL)",
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B",
          "limit": {
            "context": 98304,
            "output": 16384
          }
        },
        "qwen3.6:35b-a3b": {
          "name": "Qwen3.6 35B-A3B",
          "limit": {
            "context": 98304,
            "output": 16384
          }
        },
        "bonsai": {
          "name": "Ternary Bonsai 2 27B",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      },
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:LLM_SERVER_URL}",
        "apiKey": "ollama"
      }
    }
  }
}
