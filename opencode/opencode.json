{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/coder",
  "theme": "system",
  "update": "disable",
  "providers": {
    "local": {
      "name": "Local remote model",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "coder": {
          "modelID": "qwen3-coder:30b",
          "name": "Qwen3 Coder 30B",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
