{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/{env:LLM_MODEL}",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (LLM_SERVER_URL)",

      "options": {
        "baseURL": "{env:LLM_SERVER_URL}"
      },

      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B",
          "limit": { "context": 32768, "output": 16384 }
        },
        "qwen3.6:27b": {
          "name": "Qwen3.6 27B (general, vision)",
          "limit": { "context": 32768, "output": 16384 }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  }
}
