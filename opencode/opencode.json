{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/{env:LLM_MODEL}",
  "small_model": "ollama/glm-4.7-flash:latest",

  "plugin": [
    "@whisperopencode/push"
  ],

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (LLM_SERVER_URL)",
      "options": {
        "baseURL": "{env:LLM_SERVER_URL}",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B",
          "limit": { "context": 262144, "output": 16384 }
        },
        "qwen3.6:27b": {
          "name": "Qwen3.6 27B",
          "limit": { "context": 262144, "output": 16384 }
        },
        "qwen3:8b-32k": {
          "name": "Qwen3 8B 32K",
          "limit": { "context": 40960, "output": 16384 }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B",
          "limit": { "context": 40960, "output": 16384 }
        },
        "qwen2.5:7b-instruct": {
          "name": "Qwen2.5 7B Instruct",
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen2.5-coder:1.5b-base": {
          "name": "Qwen2.5 Coder 1.5B Base",
          "limit": { "context": 32768, "output": 8192 }
        },
        "glm-4.7-flash:latest": {
          "name": "GLM 4.7 Flash",
          "limit": { "context": 202752, "output": 16384 }
        },
        "hf.co/mradermacher/Huihui-ThinkingCap-Qwen3.6-27B-abliterated-GGUF:Q4_K_M": {
          "name": "ThinkingCap Qwen3.6 27B Abliterated",
          "limit": { "context": 262144, "output": 16384 }
        },
        "hf.co/bartowski/TheDrummer_Cydonia-24B-v4.3-GGUF:Q5_K_M": {
          "name": "Cydonia 24B v4.3",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.6": {
          "name": "Grok 4.6"
        },
        "grok-4.5": {
          "name": "Grok 4.5"
        },
        "grok-4.3": {
          "name": "Grok 4.3"
        }
      }
    }
  }
}
