{
  "$schema": "https://opencode.ai/config.json",

  "model": "llama.cpp/qwen-coder",

  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "arch alex r9700",

      "options": {
        "baseURL": "{env:LLM_SERVER_URL}"
      },

      "models": {
        "qwen-coder": {
          "name": "Qwen Local - R9700",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  }
}
